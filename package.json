{
  "name": "wc2026-stickers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && rm -f dist/_redirects",
    "preview": "vite preview",
    "seed": "node scripts/seed-checklist.mjs",
    "images": "node scripts/fetch-sticker-images.mjs",
    "images:force": "node scripts/fetch-sticker-images.mjs --force",
    "deploy:pages": "rm -f dist/_redirects && wrangler deploy",
    "deploy:pages:preview": "rm -f dist/_redirects && wrangler deploy"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.104.0"
  }
}
